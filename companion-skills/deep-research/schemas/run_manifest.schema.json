{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunManifest",
  "description": "Manifest for a single research run. Created at init, updated throughout.",
  "type": "object",
  "required": ["version", "query", "mode", "started_at", "report_dir", "artifact_paths"],
  "properties": {
    "version": {
      "type": "string",
      "const": "3.0.0"
    },
    "query": {
      "type": "string",
      "description": "Original research question"
    },
    "mode": {
      "type": "string",
      "enum": ["quick", "standard", "deep", "ultradeep"]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "default": null
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assumption_id", "text", "materiality", "status"],
        "properties": {
          "assumption_id": {
            "type": "string",
            "pattern": "^asm_[0-9a-f]{8}$"
          },
          "text": { "type": "string" },
          "materiality": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "status": {
            "type": "string",
            "enum": ["implicit", "user_confirmed", "evidence_validated"]
          }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "provider_config": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string",
          "description": "First-pass search provider (default native-web-search)"
        },
        "wide_discovery": {
          "type": ["string", "null"],
          "description": "Second-pass coordinated discovery harness (default search-as-code for Standard/Deep/UltraDeep)"
        },
        "follow_up": {
          "type": ["string", "null"],
          "description": "Third-pass targeted gap provider (default perplexity-search-mcp)"
        },
        "scholarly": {
          "type": ["string", "null"],
          "description": "Scholarly API provider if configured (e.g. openalex, semantic_scholar)"
        },
        "biomedical": {
          "type": ["string", "null"],
          "description": "Biomedical structured retrieval layer when used (e.g. biomcp)"
        },
        "citation_intelligence": {
          "type": ["string", "null"],
          "description": "Citation-intelligence layer when used (e.g. scite)"
        },
        "financial": {
          "type": ["string", "null"],
          "description": "Structured financial/market data layer when used (e.g. fmp)"
        },
        "independent_cross_check": {
          "type": ["string", "null"],
          "description": "Optional supplemental web/search provider used for an independent cross-check"
        }
      },
      "default": {
        "primary": "native-web-search",
        "wide_discovery": "search-as-code",
        "follow_up": "perplexity-search-mcp",
        "scholarly": null,
        "biomedical": null,
        "citation_intelligence": null,
        "financial": null,
        "independent_cross_check": null
      }
    },
    "report_dir": {
      "type": "string",
      "description": "Absolute path to the report directory"
    },
    "artifact_paths": {
      "type": "object",
      "required": ["sources", "evidence", "claims", "report"],
      "properties": {
        "sources": { "type": "string", "default": "sources.jsonl" },
        "evidence": { "type": "string", "default": "evidence.jsonl" },
        "claims": { "type": "string", "default": "claims.jsonl" },
        "file_manifest": { "type": "string", "default": "file_manifest.jsonl" },
        "data_profile": { "type": "string", "default": "data_profile.jsonl" },
        "report": { "type": "string", "default": "report.md" },
        "plan": { "type": "string", "default": "plan.json" },
        "coverage_map": { "type": "string", "default": "coverage_map.json" },
        "audit_manifest": { "type": "string", "default": "audit_manifest.json" },
        "ledger_index": { "type": "string", "default": "ledger_index.json" }
      },
      "additionalProperties": false
    },
    "execution_trace": {
      "type": "object",
      "description": "Warn-first run-trace accounting for planned lanes, provider calls, subagents, phase metrics, and coverage.",
      "required": ["version", "provider_calls", "subagents", "lane_source_counts", "query_family_source_counts", "events"],
      "properties": {
        "version": { "type": "string" },
        "provider_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["provider_call_id", "provider", "tool", "query", "lane_id", "status", "started_at"],
            "properties": {
              "provider_call_id": { "type": "string" },
              "provider": { "type": "string" },
              "tool": { "type": "string" },
              "query": { "type": "string" },
              "lane_id": { "type": ["string", "null"] },
              "query_family_id": { "type": ["string", "null"] },
              "started_at": { "type": "string", "format": "date-time" },
              "finished_at": { "type": ["string", "null"], "format": "date-time" },
              "status": { "type": "string" },
              "result_count": { "type": "integer", "minimum": 0 },
              "retained_source_count": { "type": "integer", "minimum": 0 },
              "artifacts": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": true
          }
        },
        "subagents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["subagent_id", "lane_id", "role", "status", "started_at"],
            "properties": {
              "subagent_id": { "type": "string" },
              "lane_id": { "type": ["string", "null"] },
              "role": { "type": "string" },
              "model": { "type": ["string", "null"] },
              "reasoning": { "type": ["string", "null"] },
              "status": { "type": "string" },
              "source_count": { "type": "integer", "minimum": 0 },
              "evidence_count": { "type": "integer", "minimum": 0 },
              "started_at": { "type": "string", "format": "date-time" },
              "finished_at": { "type": ["string", "null"], "format": "date-time" }
            },
            "additionalProperties": true
          }
        },
        "lane_source_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "query_family_source_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "phase_metrics": {
          "type": "object",
          "description": "Per-phase searches, sources, tokens, cost, and wall-clock timing.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "phase": { "type": "string" },
              "status": { "type": "string" },
              "started_at": { "type": ["string", "null"], "format": "date-time" },
              "finished_at": { "type": ["string", "null"], "format": "date-time" },
              "duration_seconds": { "type": "number", "minimum": 0 },
              "provider_call_count": { "type": "integer", "minimum": 0 },
              "subagent_count": { "type": "integer", "minimum": 0 },
              "result_count": { "type": "integer", "minimum": 0 },
              "retained_source_count": { "type": "integer", "minimum": 0 },
              "evidence_count": { "type": "integer", "minimum": 0 },
              "input_tokens": { "type": "integer", "minimum": 0 },
              "output_tokens": { "type": "integer", "minimum": 0 },
              "total_tokens": { "type": "integer", "minimum": 0 },
              "estimated_cost_usd": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": true
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event_id", "phase", "status", "created_at"],
            "properties": {
              "event_id": { "type": "string" },
              "phase": { "type": "string" },
              "status": { "type": "string" },
              "created_at": { "type": "string", "format": "date-time" },
              "message": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "continuation": {
      "type": ["object", "null"],
      "description": "Populated when resuming a previous run",
      "properties": {
        "previous_run_manifest": { "type": "string" },
        "resumed_at": { "type": "string", "format": "date-time" },
        "sections_completed": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "default": null
    },
    "cross_model_critiques": {
      "type": "array",
      "description": "Optional time-boxed cross-model critique runs over draft report and claims sample.",
      "items": {
        "type": "object",
        "required": ["reviewer", "status", "created_at", "prompt_path", "output_path", "prompt_hash"],
        "properties": {
          "reviewer": { "type": "string" },
          "surface": { "type": ["string", "null"] },
          "model": { "type": ["string", "null"] },
          "reasoning_effort": { "type": ["string", "null"] },
          "status": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "finished_at": { "type": ["string", "null"], "format": "date-time" },
          "command": { "type": ["string", "null"] },
          "timeout_seconds": { "type": "integer", "minimum": 1 },
          "prompt_path": { "type": "string" },
          "output_path": { "type": "string" },
          "summary_path": { "type": "string" },
          "prompt_hash": { "type": "string" },
          "claim_count": { "type": "integer", "minimum": 0 },
          "returncode": { "type": ["integer", "null"] },
          "stderr_tail": { "type": "string" }
        },
        "additionalProperties": true
      },
      "default": []
    },
    "self_eval": {
      "type": ["object", "null"],
      "description": "Internal self-evaluation result written by scripts/run_eval.py.",
      "required": ["version", "eval_run_id", "task_id", "status", "evaluated_at", "strict", "judge", "checks"],
      "properties": {
        "version": { "type": "string" },
        "eval_run_id": { "type": "string" },
        "task_id": { "type": ["string", "null"] },
        "task_category": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["pass", "fail"] },
        "evaluated_at": { "type": "string", "format": "date-time" },
        "strict": { "type": "boolean" },
        "judge": {
          "type": "object",
          "required": ["provider", "model", "version", "prompt_hash", "rubric_version", "status"],
          "properties": {
            "provider": { "type": "string" },
            "model": { "type": "string" },
            "version": { "type": "string" },
            "prompt_hash": { "type": "string" },
            "rubric_version": { "type": "string" },
            "temperature": { "type": ["string", "number"] },
            "seed": { "type": "string" },
            "status": { "type": "string", "enum": ["ok", "failed", "skipped"] }
          },
          "additionalProperties": false
        },
        "checks": {
          "type": "array",
          "items": { "type": "object" }
        },
        "counts": { "type": "object" },
        "race_scores": {
          "type": "object",
          "properties": {
            "instruction_following": { "type": "number" },
            "comprehensiveness": { "type": "number" },
            "insight": { "type": "number" },
            "writing_objectivity": { "type": "number" }
          },
          "additionalProperties": false
        },
        "race_rationales": { "type": "object" },
        "race_overall": { "type": "number" },
        "fact_mini": { "type": "object" },
        "delivery_gate": { "type": "object" },
        "artifact_hashes": { "type": "object" },
        "artifact_mtimes": { "type": "object" },
        "network_mode": { "type": "string", "enum": ["disabled", "enabled"] },
        "network_used": { "type": "boolean" },
        "llm_used": { "type": "boolean" },
        "result_path": { "type": "string" },
        "incomplete_reason": { "type": ["string", "null"] },
        "elapsed_seconds": { "type": "number" }
      },
      "additionalProperties": false,
      "default": null
    }
  },
  "additionalProperties": false
}
