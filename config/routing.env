# Gauntlet model-routing config — THE single source of truth for model IDs, display
# names, and reasoning-effort tiers. Shell-sourceable (`. config/routing.env`) and
# grep/parse-friendly: `KEY="value"`, one per line, no logic.
#
# A model bump is an edit HERE, then:
#   make routing-lint     # lists every file still carrying a stale name, file:line
#   make check            # re-runs the whole deterministic gate against these values
#
# Who reads this file:
#   scripts/run_review.sh    — reviewer model + effort defaults (env still overrides)
#   scripts/render_prompt.sh — substitutes the {{ROUTING}} tokens in the reviewer template
#   scripts/routing_lint.sh  — fails on any stale model literal anywhere in the repo
#   eval/check.sh            — derives its routing assertions from these values
#
# Precedence: explicit env (REVIEWER_MODEL, REVIEWER_EFFORT, …) > this file > script default.

# ── First pass (Claude side, in-session) ────────────────────────────────────────
GAUNTLET_LEAD_MODEL_DISPLAY="Opus 4.8"          # orchestrator + adjudicator (this session)
GAUNTLET_LEAD_EFFORT="xhigh"
GAUNTLET_WORKER_MODEL_ID="claude-sonnet-5"      # deep-research lanes + Agent subagents
GAUNTLET_WORKER_MODEL_DISPLAY="Sonnet 5"
GAUNTLET_WORKER_EFFORT="xhigh"

# ── Adversarial review (codex side, Stage 2) ────────────────────────────────────
GAUNTLET_REVIEWER_MODEL_ID="gpt-5.6-sol"        # passed to `codex exec -m`
GAUNTLET_REVIEWER_MODEL_DISPLAY="GPT-5.6 Sol"
GAUNTLET_REVIEWER_JUDGE_EFFORT="xhigh"          # the single synthesizing judge
GAUNTLET_REVIEWER_LANE_EFFORT="high"            # each of the 4 parallel research lanes

# ── Drift-lint classes ──────────────────────────────────────────────────────────
# Each entry is `CLASS_REGEX|EXPECTED_VALUE`. routing_lint.sh flags every match of
# CLASS_REGEX in the repo whose text is not EXPECTED_VALUE — that is how a half-finished
# model bump is caught in prose that cannot be tokenized (SKILL.md, README.md, docs).
GAUNTLET_LINT_CLASSES="\
gpt-[0-9]+\.[0-9]+(-[a-z]+)?|gpt-5.6-sol
GPT-[0-9]+\.[0-9]+ [A-Z][a-z]+|GPT-5.6 Sol
claude-sonnet-[0-9]+(\.[0-9]+)?|claude-sonnet-5
Sonnet [0-9]+(\.[0-9]+)?|Sonnet 5
Opus [0-9]+(\.[0-9]+)?|Opus 4.8"
